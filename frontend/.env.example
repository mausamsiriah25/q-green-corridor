# Copy this file to frontend/.env and fill in your own key.
# Never commit the real .env file.

# Browser-restricted Google Maps API key (Maps JavaScript API + Places
# library). Used for address search, geocoding, current-location reverse
# geocoding, the optional Google-basemap driver map, and the illustrative
# Google-vs-QPSO route comparison panel.
#
# If left blank, Q-GREEN CORRIDOR runs entirely on the existing simulated
# Leaflet map -- nothing breaks, address search is just disabled (or falls
# back to the server-side proxy below, if configured).
VITE_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE

# Which map is shown by default: "google" or "leaflet". Only takes effect
# if VITE_GOOGLE_MAPS_API_KEY is also set and valid -- otherwise this
# always falls back to "leaflet" and the user can still switch manually
# in the UI whenever Google Maps is available.
VITE_MAP_PROVIDER=leaflet
